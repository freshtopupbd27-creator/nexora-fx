
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXORA FX | Premium Bot Store</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080808;color:#eee;font-family:Arial,sans-serif}
header{padding:20px 5%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #292318;background:#101010;position:sticky;top:0;z-index:5}
.logo{font-size:24px;font-weight:bold;color:#e9bd58;letter-spacing:2px}
button{background:#d6a83d;color:#111;border:0;border-radius:7px;padding:11px 17px;font-weight:bold;cursor:pointer}
button.secondary{background:#242424;color:#eee;border:1px solid #555}
button.danger{background:#a72d2d;color:white}
button:disabled{opacity:.5}
.hero{text-align:center;padding:65px 18px 45px;background:linear-gradient(130deg,#17130a,#090909 65%)}
.hero h1{font-size:38px;color:#e9bd58;margin:0 0 12px}
.hero p{color:#aaa;line-height:1.7}
main{max-width:1100px;margin:auto;padding:25px 16px}
h2{color:#e9bd58}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
.card{background:#151515;border:1px solid #383024;border-radius:12px;overflow:hidden}
.card img{width:100%;height:210px;object-fit:cover;background:#222}
.cardbody{padding:17px}
.card h3{color:#e9bd58;margin-top:0}
.meta{color:#bbb;font-size:14px;line-height:1.8}
.price{font-size:22px;color:#e9bd58;font-weight:bold;margin:12px 0}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
input,textarea{width:100%;padding:12px;margin:7px 0 14px;background:#101010;color:white;border:1px solid #555;border-radius:7px}
textarea{min-height:90px;resize:vertical}
label{color:#d8b45e;font-size:14px}
.modal{display:none;position:fixed;inset:0;background:#000d;z-index:10;overflow:auto;padding:20px}
.modalbox{max-width:550px;margin:30px auto;background:#171717;border:1px solid #b18b3e;border-radius:12px;padding:22px}
.close{float:right;background:#333;color:white}
#adminPanel{display:none;margin-top:35px;padding:20px;background:#141414;border:1px solid #59451e;border-radius:12px}
footer{text-align:center;color:#777;padding:35px;border-top:1px solid #292929;margin-top:40px}
.small{color:#999;font-size:12px}
.gallery{display:flex;gap:7px;overflow:auto;margin:10px 0}
.gallery img{width:75px;height:65px;object-fit:cover;border-radius:6px;cursor:pointer}
</style>
</head>
<body>

<header>
<div class="logo">NEXORA FX</div>
<div class="actions">
<button class="secondary" onclick="openLogin()">Login</button>
<button onclick="logout()" id="logoutBtn" style="display:none">Logout</button>
</div>
</header>

<section class="hero">
<h1>NEXORA FX</h1>
<p>Premium Forex Trading Bots for MT4, MT5 & OTC Markets</p>
<p>Explore our trading tools and discover their features.</p>
</section>

<main>
<h2>Our Trading Bots</h2>
<div id="botList" class="grid">
<p>Loading bots...</p>
</div>

<section id="adminPanel">
<h2>Admin Dashboard</h2>
<p class="small">Add, edit or remove your trading bots.</p>

<form id="botForm">
<input type="hidden" id="botId">

<label>Bot Name</label>
<input id="name" required placeholder="Enter bot name">

<label>Description</label>
<textarea id="description" placeholder="Bot description"></textarea>

<label>Stop Loss</label>
<input id="sl" placeholder="Example: Dynamic SL">

<label>Profit Target</label>
<input id="tp" placeholder="Example: 5% target">

<label>Minimum Capital</label>
<input id="capital" placeholder="Example: $100">

<label>Price</label>
<input id="price" placeholder="Example: $49">

<label>Supported Platforms</label>
<input id="platforms" placeholder="MT4, MT5, OTC">

<label>Telegram Contact Link</label>
<input id="telegram" placeholder="https://t.me/yourusername">

<label>Bot Images (select multiple)</label>
<input id="images" type="file" accept="image/*" multiple>

<div class="actions">
<button type="submit" id="saveBtn">Save Bot</button>
<button type="button" class="secondary" onclick="resetForm()">Clear Form</button>
</div>
</form>

<h2>Manage Bots</h2>
<div id="adminBots"></div>
</section>
</main>

<div class="modal" id="loginModal">
<div class="modalbox">
<button class="close" onclick="closeLogin()">Close</button>
<h2>Account Login</h2>
<label>Email</label>
<input id="email" type="email" placeholder="Enter email">
<label>Password</label>
<input id="password" type="password" placeholder="Enter password">
<div class="actions">
<button onclick="login()">Login</button>
<button class="secondary" onclick="register()">Create Account</button>
</div>
<p class="small" id="loginMessage"></p>
</div>
</div>

<div class="modal" id="detailModal">
<div class="modalbox">
<button class="close" onclick="closeDetails()">Close</button>
<div id="detailContent"></div>
</div>
</div>

<footer>
<p>© 2026 NEXORA FX. All Rights Reserved.</p>
<p>Trading involves risk. Past performance does not guarantee future results.</p>
</footer>

<script>
const SUPABASE_URL = "https://rhpwkvmwapljuslxkxom.supabase.co";
const SUPABASE_KEY = "sb_publishable_eVXhSc191C6Gw-bp4CAuKQ_h_U9wEfA";
const ADMIN_UID = "7ad49d5a-729c-4449-9628-2e9332d65199";

const db = window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
let currentUser = null;
let bots = [];

function openLogin(){
 document.getElementById("loginModal").style.display="block";
}
function closeLogin(){
 document.getElementById("loginModal").style.display="none";
}
function closeDetails(){
 document.getElementById("detailModal").style.display="none";
}

async function login(){
 const email=document.getElementById("email").value.trim();
 const password=document.getElementById("password").value;
 const msg=document.getElementById("loginMessage");
 if(!email||!password){msg.textContent="Enter email and password.";return;}
 msg.textContent="Signing in...";
 const {data,error}=await db.auth.signInWithPassword({email,password});
 if(error){msg.textContent=error.message;return;}
 currentUser=data.user;
 await updateAccount();
 closeLogin();
}

async function register(){
 const email=document.getElementById("email").value.trim();
 const password=document.getElementById("password").value;
 const msg=document.getElementById("loginMessage");
 if(!email||password.length<6){msg.textContent="Enter email and password (at least 6 characters).";return;}
 msg.textContent="Creating account...";
 const {data,error}=await db.auth.signUp({email,password});
 if(error){msg.textContent=error.message;return;}
 msg.textContent=data.session?"Account created.":"Account created. Check your email for confirmation.";
}

async function logout(){
 await db.auth.signOut();
 currentUser=null;
 await updateAccount();
}

async function updateAccount(){
 const isAdmin=currentUser && currentUser.id===ADMIN_UID;
 document.getElementById("adminPanel").style.display=isAdmin?"block":"none";
 document.getElementById("logoutBtn").style.display=currentUser?"inline-block":"none";
 await loadBots();
}

async function loadBots(){
 const {data,error}=await db.from("bots")
 .select("*").eq("is_active",true).order("created_at",{ascending:false});
 const list=document.getElementById("botList");
 if(error){list.innerHTML="<p>Unable to load bots: "+escapeHTML(error.message)+"</p>";return;}
 bots=data||[];
 if(!bots.length){list.innerHTML="<p>No bots available yet. Please check again later.</p>";}
 else{
 list.innerHTML=bots.map(b=>{
 const img=b.images&&b.images.length?b.images[0]:"";
 return `<article class="card">
 ${img?`<img src="${escapeHTML(img)}" alt="Bot image">`:"<div style='height:210px;background:#222;display:grid;place-items:center;color:#bd9846'>NEXORA FX</div>"}
 <div class="cardbody">
 <h3>${escapeHTML(b.name)}</h3>
 <div class="meta">${escapeHTML(b.platforms||"")}</div>
 <div class="price">${escapeHTML(b.price||"Contact for price")}</div>
 <button onclick="showDetails(${Number(b.id)})">View Details</button>
 </div></article>`;
 }).join("");
 }
 if(currentUser&&currentUser.id===ADMIN_UID)renderAdminBots();
}

function escapeHTML(value){
 return String(value??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

function showDetails(id){
 const b=bots.find(x=>x.id===id);
 if(!b)return;
 const imgs=b.images||[];
 document.getElementById("detailContent").innerHTML=`
 <h2>${escapeHTML(b.name)}</h2>
 <div id="mainGallery">
 ${imgs.length?`<img id="mainImage" src="${escapeHTML(imgs[0])}" style="width:100%;max-height:300px;object-fit:contain">`:""}
 <div class="gallery">${imgs.map((u,i)=>`<img src="${escapeHTML(u)}" onclick="changeImage('${escapeHTML(u)}')">`).join("")}</div>
 </div>
 <p>${escapeHTML(b.description)}</p>
 <p class="meta">Stop Loss: ${escapeHTML(b.stop_loss)}</p>
 <p class="meta">Profit Target: ${escapeHTML(b.profit_target)}</p>
 <p class="meta">Minimum Capital: ${escapeHTML(b.minimum_capital)}</p>
 <p class="meta">Platforms: ${escapeHTML(b.platforms)}</p>
 <div class="price">${escapeHTML(b.price)}</div>
 ${b.telegram_link?`<a href="${escapeHTML(b.telegram_link)}" target="_blank" rel="noopener"><button>Contact on Telegram</button></a>`:""}`;
 document.getElementById("detailModal").style.display="block";
}

function changeImage(url){
 document.getElementById("mainImage").src=url;
}

async function saveBot(event){
 event.preventDefault();
 if(!currentUser||currentUser.id!==ADMIN_UID){alert("Admin login required.");return;}
 const btn=document.getElementById("saveBtn");
 btn.disabled=true;btn.textContent="Saving...";
 try{
 const id=document.getElementById("botId").value;
 const files=Array.from(document.getElementById("images").files||[]);
 let existing=[];
 if(id){
 const old=bots.find(b=>String(b.id)===id);
 existing=old?.images||[];
 }
 const uploaded=[];
 for(const file of files){
 const safeName=file.name.replace(/[^a-zA-Z0-9._-]/g,"_");
 const path=Date.now()+"_"+Math.random().toString(36).slice(2)+"_"+safeName;
 const {error:uploadError}=await db.storage.from("bot-images").upload(path,file);
 if(uploadError)throw uploadError;
 const {data}=db.storage.from("bot-images").getPublicUrl(path);
 uploaded.push(data.publicUrl);
 }
 const record={
 name:document.getElementById("name").value.trim(),
 description:document.getElementById("description").value.trim(),
 stop_loss:document.getElementById("sl").value.trim(),
 profit_target:document.getElementById("tp").value.trim(),
 minimum_capital:document.getElementById("capital").value.trim(),
 price:document.getElementById("price").value.trim(),
 platforms:document.getElementById("platforms").value.trim(),
 telegram_link:document.getElementById("telegram").value.trim(),
 images:[...existing,...uploaded],
 is_active:true
 };
 if(!record.name)throw new Error("Bot name is required.");
 let result;
 if(id){
 result=await db.from("bots").update(record).eq("id",Number(id));
 }else{
 result=await db.from("bots").insert(record);
 }
 if(result.error)throw result.error;
 alert("Bot saved successfully.");
 resetForm();
 await loadBots();
 }catch(e){
 alert("Save failed: "+e.message);
 }finally{
 btn.disabled=false;btn.textContent="Save Bot";
 }
}

function renderAdminBots(){
 const box=document.getElementById("adminBots");
 box.innerHTML=bots.map(b=>`
 <div class="card" style="padding:14px;margin:10px 0">
 <strong>${escapeHTML(b.name)}</strong>
 <div class="actions">
 <button onclick="editBot(${Number(b.id)})">Edit</button>
 <button class="danger" onclick="deleteBot(${Number(b.id)})">Delete</button>
 </div></div>`).join("");
}

function editBot(id){
 const b=bots.find(x=>x.id===id);
 if(!b)return;
 document.getElementById("botId").value=b.id;
 document.getElementById("name").value=b.name||"";
 document.getElementById("description").value=b.description||"";
 document.getElementById("sl").value=b.stop_loss||"";
 document.getElementById("tp").value=b.profit_target||"";
 document.getElementById("capital").value=b.minimum_capital||"";
 document.getElementById("price").value=b.price||"";
 document.getElementById("platforms").value=b.platforms||"";
 document.getElementById("telegram").value=b.telegram_link||"";
 document.getElementById("saveBtn").textContent="Update Bot";
 document.getElementById("botForm").scrollIntoView({behavior:"smooth"});
}

async function deleteBot(id){
 if(!confirm("Are you sure you want to delete this bot?"))return;
 const {error}=await db.from("bots").delete().eq("id",id);
 if(error){alert(error.message);return;}
 alert("Bot deleted.");
 await loadBots();
}

function resetForm(){
 document.getElementById("botForm").reset();
 document.getElementById("botId").value="";
 document.getElementById("saveBtn").textContent="Save Bot";
}

document.getElementById("botForm").addEventListener("submit",saveBot);

async function startApp(){
 const {data,error}=await db.auth.getSession();
 if(error)console.error(error);
 currentUser=data?.session?.user||null;
 await updateAccount();
}
startApp();
</script>
</body>
</html>
